rules_version = '2';

// Regras da Missão Farol (nível 3) aplicadas à coleção `items`:
// leitura pública, escrita negada. Qualquer outra coleção é negada por padrão.
service cloud.firestore {
  match /databases/{database}/documents {
    match /items/{item} {
      allow read: if true;
      allow write: if false;
    }
  }
}
