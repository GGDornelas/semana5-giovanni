# Copie para frontend/.env.local e ajuste. NUNCA versione o .env.local.

# Fonte de dados da página: "api" (Django da Semana 5) ou "firestore" (Semana 6)
NEXT_PUBLIC_DATA_SOURCE=api

# true = usa o Firestore Emulator local (firebase emulators:start)
NEXT_PUBLIC_USE_EMULATOR=false
NEXT_PUBLIC_FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# Config web do Firebase (pública por design: Configurações do projeto > Seus apps)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=semana6-giovanni.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=semana6-giovanni
NEXT_PUBLIC_FIREBASE_APP_ID=
